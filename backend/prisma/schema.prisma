datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  users       User[]

  @@map("roles")
}

model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  passwordHash       String           @map("password_hash")
  recoveryCodeHash   String?          @map("recovery_code_hash")
  firstName          String           @map("first_name")
  lastName           String           @map("last_name")
  emailNotifications Boolean          @default(true) @map("email_notifications")
  inAppNotifications Boolean          @default(true) @map("in_app_notifications")
  roleId             String           @map("role_id")
  role               Role             @relation(fields: [roleId], references: [id])
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  sessionVersion     Int              @default(0) @map("session_version")
  spacesCreated      Space[]          @relation("SpaceCreator")
  spacesJoined       SpaceMember[]
  spaceInvitesSent   SpaceInvite[]    @relation("SpaceInviteSender")
  spaceInvites       SpaceInvite[]    @relation("SpaceInviteRecipient")
  tasksAssigned      Task[]           @relation("TaskAssignee")
  taskAssignments    TaskAssignee[]
  tasksCreated       Task[]           @relation("TaskCreator")
  attachments        Attachment[]
  taskVisibility     TaskVisibility[]
  comments           Comment[]
  notifications      Notification[]
  activityLogs       ActivityLog[]

  @@index([roleId])
  @@index([createdAt])
  @@map("users")
}

model Space {
  id          String        @id @default(uuid())
  name        String
  // Legacy field retained for existing databases; the API and UI do not use it.
  description String?
  color       String        @default("#0079BF")
  isPrivate   Boolean       @default(true) @map("is_private")
  createdById String        @map("created_by_id")
  createdBy   User          @relation("SpaceCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  members     SpaceMember[]
  invites     SpaceInvite[]
  tasks       Task[]

  @@index([createdById, name])
  @@index([createdAt])
  @@map("spaces")
}

model SpaceMember {
  id       String   @id @default(uuid())
  spaceId  String   @map("space_id")
  space    Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([spaceId, userId])
  @@index([userId, spaceId])
  @@map("space_members")
}

model SpaceInvite {
  id            String         @id @default(uuid())
  spaceId       String         @map("space_id")
  space         Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  invitedUserId String         @map("invited_user_id")
  invitedUser   User           @relation("SpaceInviteRecipient", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedById   String         @map("invited_by_id")
  invitedBy     User           @relation("SpaceInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  status        String         @default("PENDING")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  respondedAt   DateTime?      @map("responded_at")
  notifications Notification[]

  @@unique([spaceId, invitedUserId])
  @@index([invitedUserId, status, createdAt])
  @@index([spaceId, status])
  @@map("space_invites")
}

model Task {
  id           String           @id @default(uuid())
  title        String
  description  String?
  status       String           @default("TODO") // "TODO", "IN_PROGRESS", "COMPLETED"
  deadline     DateTime
  spaceId      String           @map("space_id")
  space        Space            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  assignedToId String?          @map("assigned_to_id")
  assignedTo   User?            @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignees    TaskAssignee[]
  createdById  String           @map("created_by_id")
  createdBy    User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  attachments  Attachment[]
  // Legacy field retained for existing databases; assignments control visibility.
  visibleToAll Boolean          @default(true) @map("visible_to_all")
  priority     String           @default("NORMAL") @map("priority")
  visibility   TaskVisibility[]
  comments     Comment[]
  tags         TaskTag[]

  @@index([spaceId, updatedAt])
  @@index([spaceId, status])
  @@index([createdById, createdAt])
  @@index([assignedToId, createdAt])
  @@index([deadline])
  @@map("tasks")
}

model Attachment {
  id           String   @id @default(uuid())
  taskId       String   @map("task_id")
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String   @map("file_name")
  filePath     String   @map("file_path")
  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type")
  uploadedById String   @map("uploaded_by_id")
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  @@index([taskId, uploadedAt])
  @@map("attachments")
}

model TaskAssignee {
  id         String   @id @default(uuid())
  taskId     String   @map("task_id")
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now()) @map("assigned_at")

  @@unique([taskId, userId])
  @@index([userId, taskId])
  @@map("task_assignees")
}

// Legacy table; new tasks do not create rows here.
model TaskVisibility {
  id     String @id @default(uuid())
  taskId String @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId, taskId])
  @@map("task_visibility")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  taskId    String   @map("task_id")
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id")
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([taskId, createdAt])
  @@map("comments")
}

model Tag {
  id    String    @id @default(uuid())
  name  String    @unique
  color String    @default("#6366f1")
  tasks TaskTag[]

  @@map("tags")
}

model TaskTag {
  id     String @id @default(uuid())
  taskId String @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  String @map("tag_id")
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@index([tagId, taskId])
  @@map("task_tags")
}

model Notification {
  id            String       @id @default(uuid())
  userId        String       @map("user_id")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String // TASK_ASSIGNED, TASK_COMPLETED, COMMENT_ADDED, ATTACHMENT_ADDED, DEADLINE_APPROACHING
  title         String
  message       String
  isRead        Boolean      @default(false) @map("is_read")
  taskId        String?      @map("task_id")
  spaceInviteId String?      @map("space_invite_id")
  spaceInvite   SpaceInvite? @relation(fields: [spaceInviteId], references: [id], onDelete: Cascade)
  resourceType  String?      @map("resource_type")
  resourceId    String?      @map("resource_id")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([resourceType, resourceId])
  @@index([userId, isRead, createdAt])
  @@index([taskId])
  @@index([spaceInviteId])
  @@map("notifications")
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("activity_logs")
}
