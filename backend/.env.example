# Konfigurimi i Serverit
PORT=5000
NODE_ENV=production

# Chpësi Sekret për JWT (Me rëndësi kritike për sigurinë!)
JWT_SECRET="b839f21276a1c890e909a32c4d519b78e1d23456789abcdef0123456789abcd"

# URL e Frontend-it për CORS dhe Cookies
FRONTEND_URL="http://localhost:3000"

# Konfigurimi i Adminit Fillestar
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Virtuo

# Konfigurimi i Databazës (PostgreSQL në Docker)
DATABASE_URL="postgresql://postgres:postgres_secure_password@db:5432/virtuo?schema=public"

# Konfigurimi i Ruajtjes së Skedarëve lokalë
UPLOAD_DIR=/app/uploads

# Konfigurimi i SMTP për Njoftimet me Email
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=user_id_ketu
SMTP_PASS=password_id_ketu
SMTP_FROM="Virtuo Task Manager" <no-reply@virtuo.local>