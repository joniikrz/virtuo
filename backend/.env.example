# Konfigurimi i Serverit
PORT=5000
NODE_ENV=development
JWT_SECRET=ndryshoje_kete_me_nje_celes_shume_te_sigurt_123456
FRONTEND_URL=http://localhost:5173

# Admin i paracaktuar (krijohet automatikisht në nisje)
ADMIN_EMAIL=admin@virtuo.local
ADMIN_PASSWORD=Admin123!
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Virtuo

# Konfigurimi i Databazës (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres_secure_password@db:5432/virtuo?schema=public"

# Konfigurimi i Ruajtjes së Skedarëve lokalë
UPLOAD_DIR=/app/uploads

# Konfigurimi i SMTP për Njoftimet me Email
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=user_id_ketu
SMTP_PASS=password_id_ketu
SMTP_FROM="Virtuo Task Manager" <no-reply@virtuo.local>
