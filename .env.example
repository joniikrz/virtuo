POSTGRES_PASSWORD=change-this-to-a-long-random-password
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-characters
BCRYPT_ROUNDS=12
COOKIE_SECURE=true
ALLOW_INITIAL_SETUP=false
ADMIN_EMAIL=admin@virtuo.local
ADMIN_PASSWORD=change-this-initial-admin-password
FRONTEND_URL=https://virtuo-tasks.local

# Prisma/PostgreSQL: connections per backend replica. Keep replicas * limit below max_connections - 20.
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT=10
DB_TRANSACTION_MAX_WAIT_MS=5000
DB_TRANSACTION_TIMEOUT_MS=15000
TASK_LIST_LIMIT=500
REQUEST_TIMEOUT_MS=30000
MAX_UPLOAD_BYTES=10485760
JSON_BODY_LIMIT=1mb

# SMTP duhet të përdorë TLS në production. Mos e çaktivizo verifikimin e certifikatës.
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Virtuo Task Manager <no-reply@virtuo.local>"
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=10000

# PostgreSQL tuning (safe starting values for a VM with about 2 GB+ RAM).
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
POSTGRES_WORK_MEM=4MB
POSTGRES_SLOW_QUERY_MS=500
POSTGRES_BIND_PORT=5432

# HTTP gateway.
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
TLS_CERT_PATH=./secrets/tls/fullchain.pem
TLS_KEY_PATH=./secrets/tls/privkey.pem

# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
